# FinFlow local development environment example
# Copy this file to .env and adjust values for your local machine.

# Identity DB (host 5436 -> finflow-postgres)
POSTGRES_DB=finflow_identity
POSTGRES_USER=finflow
POSTGRES_PASSWORD=change_me_identity_db_password

# Account DB (host 5437 -> finflow-account-postgres)
ACCOUNT_POSTGRES_DB=finflow_accounts
ACCOUNT_POSTGRES_USER=finflow_account
ACCOUNT_POSTGRES_PASSWORD=change_me_account_db_password

# Shared JWT secret used by identity-service and account-service
JWT_SECRET=change_me_shared_jwt_secret_min_32_chars

# Optional JWT expiration for identity-service
JWT_EXP=3600
